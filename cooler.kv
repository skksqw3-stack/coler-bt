#:import dp kivy.metrics.dp
#:import sp kivy.metrics.sp

<HomeScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(12)
        BoxLayout:
            size_hint_y: None
            height: dp(52)
            Label:
                text: "Cooler Control"
                font_size: sp(23)
                bold: True
                halign: "left"
                text_size: self.size
            Label:
                text: ("● BT " + root.connection_text)
                color: (0.25, 0.9, 0.55, 1) if root.connected else (0.95, 0.55, 0.4, 1)
                size_hint_x: 0.8
        BoxLayout:
            orientation: "vertical"
            padding: dp(18)
            spacing: dp(8)
            canvas.before:
                Color:
                    rgba: 0.12, 0.17, 0.26, 1
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(20)]
            Label:
                text: root.temperature + " °C"
                font_size: sp(42)
                bold: True
            Label:
                text: "Humidity: " + root.humidity + " %     Time: " + root.rtc_time
                font_size: sp(17)
        GridLayout:
            cols: 2
            spacing: dp(12)
            Button:
                text: "💧 Pump"
                background_normal: ""
                background_color: 0.08, 0.48, 0.85, 1
                on_release: app.toggle("1")
            Button:
                text: "Slow Motor"
                background_normal: ""
                background_color: 0.86, 0.68, 0.12, 1
                color: 0.08, 0.08, 0.08, 1
                on_release: app.toggle("2")
            Button:
                text: "Fast Motor"
                background_normal: ""
                background_color: 0.95, 0.36, 0.12, 1
                on_release: app.toggle("3")
            Button:
                text: "Mode Auto/Manual"
                background_normal: ""
                background_color: 0.48, 0.28, 0.82, 1
                on_release: app.toggle("4")
        Widget:
            size_hint_y: 0.2
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(6)
            Button:
                text: "Home"
                on_release: app.sm.current = "home"
            Button:
                text: "Timer"
                on_release:
                    app.sm.current = "timer"
                    app.update_timer_preview()
            Button:
                text: "Status"
                on_release:
                    app.sm.current = "status"
                    app.refresh_status()
            Button:
                text: "Settings"
                on_release: app.sm.current = "settings"

<TimerScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(16)
        spacing: dp(10)
        Label:
            text: "Timer Setup"
            font_size: sp(25)
            bold: True
            size_hint_y: None
            height: dp(45)
        ScrollView:
            do_scroll_x: False
            GridLayout:
                cols: 1
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height
                Label:
                    text: "ON Time (Turn On)"
                    font_size: sp(19)
                    size_hint_y: None
                    height: dp(35)
                TimePicker:
                    id: on_picker
                    on_hour: app.update_timer_preview()
                    on_minute: app.update_timer_preview()
                Label:
                    text: "OFF Time (Turn Off)"
                    font_size: sp(19)
                    size_hint_y: None
                    height: dp(35)
                TimePicker:
                    id: off_picker
                    on_hour: app.update_timer_preview()
                    on_minute: app.update_timer_preview()
                Label:
                    text: root.preview
                    font_size: sp(18)
                    size_hint_y: None
                    height: dp(40)
                Button:
                    text: "Save and Send"
                    size_hint_y: None
                    height: dp(52)
                    on_release: app.save_timer()
                Label:
                    text: root.feedback
                    size_hint_y: None
                    height: dp(42)
                Button:
                    text: "Toggle Timer ON/OFF"
                    size_hint_y: None
                    height: dp(48)
                    on_release: app.toggle("T")
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            Button:
                text: "Back to Home"
                on_release: app.sm.current = "home"

<StatusScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(8)
        Label:
            text: "Cooler Status"
            font_size: sp(24)
            bold: True
            size_hint_y: None
            height: dp(40)
        GridLayout:
            cols: 2
            spacing: dp(8)
            size_hint_y: None
            height: dp(145)
            Label:
                text: "Temperature"
            Label:
                text: root.temperature
            Label:
                text: "Humidity"
            Label:
                text: root.humidity
            Label:
                text: "RTC Time"
            Label:
                text: root.rtc_time
        GridLayout:
            cols: 2
            spacing: dp(5)
            size_hint_y: None
            height: dp(120)
            Label:
                text: "Pump: " + root.pump
            Label:
                text: "Motor: " + root.motor
            Label:
                text: "Mode: " + root.mode
            Label:
                text: "Timer: " + root.timer
        Button:
            text: "Refresh"
            size_hint_y: None
            height: dp(48)
            on_release: app.refresh_status()
        Label:
            text: "Communication Log"
            size_hint_y: None
            height: dp(30)
        ScrollView:
            do_scroll_x: False
            Label:
                id: log_text
                text: ""
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                halign: "left"
                valign: "top"
                font_size: sp(13)
        BoxLayout:
            size_hint_y: None
            height: dp(45)
            Button:
                text: "Home"
                on_release: app.sm.current = "home"
            Button:
                text: "Settings"
                on_release: app.sm.current = "settings"

<SettingsScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(14)
        spacing: dp(8)
        Label:
            text: "Settings"
            font_size: sp(24)
            bold: True
            size_hint_y: None
            height: dp(42)
        Label:
            text: "Bluetooth Classic / HC-05 Connection"
            size_hint_y: None
            height: dp(30)
        Spinner:
            id: device_spinner
            text: "Select paired device"
            values: ()
            size_hint_y: None
            height: dp(48)
            on_text: root.selected_device = self.text
        BoxLayout:
            size_hint_y: None
            height: dp(46)
            spacing: dp(6)
            Button:
                text: "Load Devices"
                on_release: app.refresh_devices()
            Button:
                text: "Connect"
                on_release: app.connect_selected()
            Button:
                text: "Disconnect"
                on_release: app.disconnect_bluetooth()
        Label:
            text: "Connection: " + root.connection_text
            size_hint_y: None
            height: dp(28)
        Label:
            text: "Set RTC Clock (HHMM)"
            font_size: sp(18)
            size_hint_y: None
            height: dp(34)
        Label:
            text: root.clock_display
            font_size: sp(32)
            bold: True
            size_hint_y: None
            height: dp(50)
        GridLayout:
            cols: 3
            spacing: dp(5)
            size_hint_y: None
            height: dp(190)
            Button:
                text: "1"
                on_release: app.clock_key("1")
            Button:
                text: "2"
                on_release: app.clock_key("2")
            Button:
                text: "3"
                on_release: app.clock_key("3")
            Button:
                text: "4"
                on_release: app.clock_key("4")
            Button:
                text: "5"
                on_release: app.clock_key("5")
            Button:
                text: "6"
                on_release: app.clock_key("6")
            Button:
                text: "7"
                on_release: app.clock_key("7")
            Button:
                text: "8"
                on_release: app.clock_key("8")
            Button:
                text: "9"
                on_release: app.clock_key("9")
            Button:
                text: "DEL"
                on_release: app.clock_key("DEL")
            Button:
                text: "0"
                on_release: app.clock_key("0")
            Button:
                text: "CLR"
                on_release: app.clock_key("CLR")
        Button:
            text: "Send Clock Setting"
            size_hint_y: None
            height: dp(48)
            on_release: app.clock_key("OK")
        Label:
            text: root.clock_feedback
            size_hint_y: None
            height: dp(35)
        Widget:
        Button:
            text: "Back to Home"
            size_hint_y: None
            height: dp(44)
            on_release: app.sm.current = "home"